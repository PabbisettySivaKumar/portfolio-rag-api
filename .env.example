GEMINI_API_KEY=
LITELLM_EMBEDDING_MODEL=gemini/gemini-embedding-001
LITELLM_CHAT_MODEL=gemini/gemini-2.5-flash

NEO4J_URI=neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Bearer token guarding POST /health/neo4j and POST /admin/ingest. Must be >=32
# chars. Leave empty to disable those endpoints (they return 503).
KEEPALIVE_TOKEN=

RAG_TOP_K=5
RAG_MIN_SCORE=0.72
FRONTEND_ORIGIN=http://localhost:3000

# Langfuse observability (LLM tracing). Leave LANGFUSE_ENABLED=false to disable.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
